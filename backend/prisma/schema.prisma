model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  passwordHash String

  analyses     Analysis[]

  createdAt    DateTime   @default(now())

  @@map("users")
}


model Analysis {
  id          String   @id @default(uuid())

  userId      String
  user        User     @relation(
    fields: [userId],
    references: [id]
  )

  company     String?
  jobTitle    String?
  score       Float?
  summary     String?

  createdAt   DateTime @default(now())

  @@map("analyses")
}